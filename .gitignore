const students = [
    {name: "Alice", score: 95},
    {name: "Bob", score: 22},
    {name: "Paul", score: 70},
    {name: "Amy", score: 70},

]

const studentNumber = students.length; // doesnt need to recalculate length every time loop is played

function gradeFor(score) {
    if (score >= 90) {
        return "A";
    }
    else if (score >= 80) {
        return "B"

    }
    else if (score >= 70) {
        return "C"

    }
    else if (score >= 60) {
        return "D"

    }    
    return "F"        
}

console.log(gradeFor(84));

for (const student of students) {
    const letter = gradeFor(student.score);
    console.log(`${student.name}: ${student.score} (${letter})`);
}

for (let i = 0; i < students.length ; i++) {
    console.log(`${i + 1}, ${students[i].name}`);
}   
for (const student of students) {
        if (student.score < 60) {
        console.log(`${student.name} needs a check-in.`)
    }
